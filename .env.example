# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored; nothing here is a secret.

# F-02 — throwaway hosted Supabase dev project, used only by
# scripts/supabase-remote.mjs (npm run test:remote / db:reset:remote /
# db:reset:noseed / db:push:dry). This project is disposable and is never
# production; `db reset` wipes whatever it points at.
#
# Get this from the dev project's dashboard: Connect panel > Session pooler
# (port 5432), not Transaction pooler (6543, can't run migrations) and not
# the direct db.<ref>.supabase.co host (IPv6-only on many networks).
# The password must be percent-encoded, as the Supabase CLI requires.
#
# SUPABASE_TEST_DB_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
