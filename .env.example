# Copy to .env.local. Local dev runs against the REMOTE Supabase project — there
# is no local stack (no Docker, no `supabase start`). Get these from the
# dashboard: Project Settings > API.
# The service role key is NEVER placed here and never gets a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Direct Postgres connection string, used only for ad-hoc SQL / RLS assertions.
# Optional for running the app.
SUPABASE_TEST_DB_URL=
